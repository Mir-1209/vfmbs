# ---- Required for the live site (set these in Vercel → Project → Settings → Environment Variables) ----

# Admin dashboard password (use a long passphrase; share only with board members)
ADMIN_PASSWORD=
# Random secret used to sign tickets and admin sessions. Generate with:  openssl rand -base64 32
SESSION_SECRET=

# Database: added automatically when you connect "Upstash for Redis" in Vercel → Storage.
# Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Optional ----

# Image uploads in the admin dashboard: added automatically when you connect a Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Confirmation emails (tickets, applications) via https://resend.com
RESEND_API_KEY=
EMAIL_FROM="VFMBS <hello@yourdomain.com>"
# Where contact / sponsorship inquiries get forwarded
NOTIFY_EMAIL=

# Canonical URL used in email links (defaults to the request host)
SITE_URL=https://vfmbs.org
